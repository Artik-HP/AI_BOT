# VPS profile. The installer creates /var/lib/ai-bot/config/.env from this file.
# Fill credentials on the VPS with the setup command from README.md.
NODE_ENV=production
BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
BOT_ACCESS_PASSWORD_HASH=
BOT_ACCESS_IDLE_MS=600000

# Both listeners stay private. The bot also serves the web UI on PORT.
HOST=127.0.0.1
PORT=12722
WEB_HOST=127.0.0.1
WEB_PORT=12723
# Generated by the installer. Keep independent from BOT_TOKEN.
WEB_ACCESS_TOKEN=
# false for SSH tunnel over HTTP; true when using the HTTPS Caddy site.
WEB_SECURE_COOKIE=false
WEB_PUBLIC_URL=

# Durable state outside versioned application files.
MEMORY_BACKEND=sqlite
MEMORY_FILE=/var/lib/ai-bot/memory.json
COMMAND_DB_FILE=/var/lib/ai-bot/commands.sqlite
INTERACTIVE_STATE_FILE=/var/lib/ai-bot/interactive-state.json
CONFIG_ENV_FILE=/var/lib/ai-bot/config/.env

# Empty URL = polling, no domain required.
# For webhook: https://bot.example.com and WEB_SECURE_COOKIE=true.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram-webhook
# Generated by the installer, used only in webhook mode.
WEBHOOK_SECRET_TOKEN=

# Explicitly enable account integrations only after configuring their credentials.
ACCOUNT_ASSISTANT_ENABLED=false
BOT_TO_BOT_ENABLED=false
AI_DAILY_REQUEST_LIMIT=100
AI_RATE_PER_MINUTE=12
AI_INSTANCE_DAILY_REQUEST_LIMIT=1000
AI_INSTANCE_RATE_PER_MINUTE=60
