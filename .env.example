# Telegram
BOT_TOKEN=
BOT_USERNAME=process.env.BOT_USERNAME

# OpenRouter / LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional / tuning
# PORT=12722
# MAX_AUDIO_BYTES=26214400

# Account assistant (optional)
# ACCOUNT_ASSISTANT_ENABLED=false
# ACCOUNT_ASSISTANT_MODE=approval
# ACCOUNT_ASSISTANT_PRIVATE_ONLY=true
# ACCOUNT_ASSISTANT_OWNER_CHAT_ID=process.env.ACCOUNT_ASSISTANT_OWNER_CHAT_ID
# ACCOUNT_ASSISTANT_ALLOW_CHATS=@trusteduser,123456789
# ACCOUNT_ASSISTANT_BLOCK_CHATS=@spamaccount,987654321
# ACCOUNT_ASSISTANT_REPLY_DELAY_MS=1200
# ACCOUNT_ASSISTANT_MIN_INTERVAL_MS=30000
# ACCOUNT_ASSISTANT_DRAFT_TTL_MS=1800000

# Userbot mode (optional)
# TELEGRAM_API_ID=process.env.TELEGRAM_API_ID
# TELEGRAM_API_HASH=process.env.TELEGRAM_API_HASH
# TELEGRAM_STRING_SESSION=process.env.TELEGRAM_STRING_SESSION
# USERBOT_START_MESSAGE=Userbot started.
# USERBOT_SEND_SELF=false

# Webhook mode (optional) — set WEBHOOK_URL to switch from long polling to a webhook
# WEBHOOK_URL=https://bot.yourdomain.ru
# WEBHOOK_PATH=/telegram-webhook
# WEBHOOK_SECRET_TOKEN=process.env.WEBHOOK_SECRET_TOKEN

# Bot-to-bot (optional)
# BOT_TO_BOT_ENABLED=false
# BOT_TO_BOT_OWNER_CHAT_ID=process.env.BOT_TO_BOT_OWNER_CHAT_ID
# CHAT_ID=-1003996551226
# BOT_TO_BOT_CHAT_ID=-1003996551226
# BOT_TO_BOT_TARGET_BOT_USERNAME=bot_API_TL_bot
# BOT_TO_BOT_ALLOW_BOTS=bot_API_TL_bot

PORT=12722
# Для VPS за Caddy задайте HOST=127.0.0.1.
HOST=0.0.0.0
# Пустой WEBHOOK_URL включает polling; для поддомена задайте полный HTTPS URL.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram-webhook
# При WEBHOOK_URL задайте случайный секрет: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=

# Interactive questions (optional)
# OPENROUTER_STREAM=false
# INTERACTIVE_STATE_FILE=./interactive-state.json
# INTERACTIVE_QUESTION_TTL_MS=86400000

# Command workspace (Node.js >=22.13)
# COMMAND_DB_FILE=./data/commands.sqlite
# WEB_HOST=127.0.0.1
# WEB_PORT=12723
# Remote panel access requires a random WEB_ACCESS_TOKEN (do not use the bot token).
# WEB_ACCESS_TOKEN=
# Set behind a trusted HTTPS proxy:
# WEB_SECURE_COOKIE=true
# OpenRouter is optional for local games, tools, notes and reminders.