# ACCOUNT_ASSISTANT_MODE=approval
# ACCOUNT_ASSISTANT_PRIVATE_ONLY=true
# ACCOUNT_ASSISTANT_OWNER_CHAT_ID=process.env.ACCOUNT_ASSISTANT_OWNER_CHAT_ID
