# Скопируйте файл в .env и заполните значения: cp .env.example .env
# .env нельзя коммитить (он в .gitignore). Писать в значения JavaScript-выражения или заглушки
# бесполезно: dotenv ничего не вычисляет, а бот отклонит такое значение при старте.

# --- Обязательные ---
# Токен бота от @BotFather, вид 123456789:AAH...
BOT_TOKEN=
# Ключ OpenRouter, https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Модели (необязательно, значения по умолчанию в комментариях) ---
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# OPENROUTER_STT_LANGUAGE=ru
# OPENROUTER_AUDIO_MODEL=thedrummer/cydonia-24b-v4.1
# Предел длины генерации (токены) и адрес API
# OPENROUTER_MAX_TOKENS=1500
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# APP_URL=http://localhost

# --- Сервер и диагностика ---
# PORT=12722
# GET /health отдаёт только ok и uptime. Подробности (GET /health/details) включаются токеном:
# HEALTH_TOKEN=
# Уровни: debug | info | warn | error | silent
# LOG_LEVEL=info
# Тексты сообщений в логах - это личные данные, по умолчанию их там нет
# LOG_MESSAGES=false

# --- Доступ и лимиты ---
# Telegram ID пользователей, которым разрешено писать боту (через запятую). Пусто - отвечать всем.
# BOT_ALLOWED_USER_IDS=
# Ваш Telegram ID: владелец видит служебные команды и всегда проходит проверки
# BOT_OWNER_CHAT_ID=
# Не больше N сообщений от одного пользователя за окно (владелец не ограничен)
# RATE_LIMIT_MESSAGES=20
# RATE_LIMIT_WINDOW_MS=60000
# Файлы: число байт или с суффиксом KB/MB/GB. Telegram отдаёт ботам файлы до 20 MB.
# MAX_AUDIO_BYTES=25MB
# MAX_IMAGE_BYTES=10MB
# Длинный ответ режется на сообщения по 4096 символов, не больше этого числа частей
# MAX_REPLY_PARTS=6
# Свой сервер Bot API (снимает лимит 20 MB на файлы)
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Память ---
# MEMORY_FILE=./memory.json
# MAX_HISTORY_MESSAGES=60
# MAX_STORED_MESSAGES=300
# MAX_MEMORY_SUMMARY_CHARS=6000
# MAX_MESSAGE_CONTENT_CHARS=4000
# MEMORY_SAVE_DEBOUNCE_MS=1000
# MEMORY_BACKUP_INTERVAL_MS=300000

# --- AI-лаборатория (только личный чат, /lab) ---
# AI_LAB_ENABLED=true
# По умолчанию MEMORY_FILE + .lab.json; отдельные JSON, backup и lock, не общая память чата
# AI_LAB_FILE=./memory.json.lab.json
# Пусто — использовать OPENROUTER_MODEL; модель не меняется автоматически
# AI_LAB_MODEL=
# AI_LAB_MAX_TOKENS=4000
# AI_LAB_TIMEOUT_MS=60000
# Жёсткий лимит зарезервированных генераций на пользователя, сутки UTC; это не денежный бюджет
# AI_LAB_DAILY_REQUESTS=30
# AI_LAB_MAX_BYTES=10MB

# --- Ассистент аккаунта (необязательно) ---
# Нужны TELEGRAM_API_ID, TELEGRAM_API_HASH и TELEGRAM_STRING_SESSION (см. блок «Сессия Telegram»)
# ACCOUNT_ASSISTANT_ENABLED=false
# approval - черновик и ваше подтверждение; dry-run - только показывать; auto - отвечать самому
# ACCOUNT_ASSISTANT_MODE=approval
# ACCOUNT_ASSISTANT_OWNER_CHAT_ID=
# ACCOUNT_ASSISTANT_PRIVATE_ONLY=true
# Кому можно отвечать (username или ID). Для режима auto список обязателен.
# ACCOUNT_ASSISTANT_ALLOW_CHATS=@trusteduser,123456789
# ACCOUNT_ASSISTANT_BLOCK_CHATS=@spamaccount,987654321
# ACCOUNT_ASSISTANT_REPLY_DELAY_MS=1200
# ACCOUNT_ASSISTANT_MIN_INTERVAL_MS=30000
# ACCOUNT_ASSISTANT_DRAFT_TTL_MS=1800000
# ACCOUNT_ASSISTANT_MAX_TEXT_CHARS=1200
# ACCOUNT_ASSISTANT_PROMPT=отвечай коротко и по-человечески
# Небезопасно: auto без списка разрешённых контактов
# ACCOUNT_ASSISTANT_AUTO_ALLOW_ANY=false

# --- Сессия Telegram (ассистент аккаунта и userbot) ---
# Получить: npm run telegram:session. Это полный доступ к аккаунту, храните только здесь.
# Одну сессию нельзя использовать в двух процессах одновременно (ассистент и userbot).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_STRING_SESSION=

# --- Userbot (npm run userbot) ---
# Команды принимаются от самого аккаунта; дополнительно можно разрешить пользователей по ID
# USERBOT_ALLOWED_USER_IDS=
# USERBOT_START_MESSAGE=Userbot started.
# USERBOT_SEND_SELF=false

# --- Общение с другими ботами (bot-to-bot) ---
# BOT_TO_BOT_ENABLED=false
# BOT_TO_BOT_OWNER_CHAT_ID=
# BOT_TO_BOT_CHAT_ID=-1001234567890
# BOT_TO_BOT_TARGET_BOT_USERNAME=peer_bot_username
# BOT_TO_BOT_ALLOW_BOTS=peer_bot_username
# BOT_TO_BOT_MAX_TURNS=6
# BOT_TO_BOT_WINDOW_MS=120000
# BOT_TO_BOT_MIN_INTERVAL_MS=2000
