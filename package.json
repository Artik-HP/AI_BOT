{
  "name": "ai_bot",
  "version": "1.0.0",
  "description": "Telegram-бот на Node.js: OpenRouter (текст, голос, фото), ассистент аккаунта, bot-to-bot и userbot",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "userbot": "node scripts/userbot.js",
    "telegram:session": "node scripts/create-telegram-session.js",
    "password:check": "node scripts/bot-password.js --check",
    "password:set": "node scripts/bot-password.js --set",
    "test": "node scripts/run-tests.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "db:migrate": "node scripts/database.js migrate",
    "db:check": "node scripts/database.js check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "node-telegram-bot-api": "^0.67.0",
    "pg": "^8.23.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  },
  "overrides": {
    "request": "npm:@cypress/request@^3.0.10",
    "qs": "^6.16.1",
    "uuid": "^11.1.1"
  }
}
